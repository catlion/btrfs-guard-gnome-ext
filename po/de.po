#: extension.js:85
msgid "Reclaim empty chunks  (balance -dusage=0)"
msgstr "Leere Chunks freigeben  (balance -dusage=0)"

#: extension.js:94
msgid "Show filesystem usage…"
msgstr "Dateisystemauslastung anzeigen…"

#: extension.js:101
#, javascript-format
msgid "Compact chunks <%d%% full  (balance -dusage=%d)"
msgstr "Chunks mit weniger als <%d%% Füllstand verdichten  (balance -dusage=%d)"

#: extension.js:148
#, javascript-format
msgid "%s unallocated: %s of %s"
msgstr "%s nicht zugewiesen: %s von %s"

#: extension.js:149
#, javascript-format
msgid "Data: %s used of %s"
msgstr "Daten: %s belegt von %s"

#: extension.js:150
#, javascript-format
msgid "Metadata: %s used of %s"
msgstr "Metadaten: %s belegt von %s"

#: extension.js:156
msgid "Btrfs: low unallocated space"
msgstr "Btrfs: wenig nicht zugewiesener Speicher"

#: extension.js:157
#, javascript-format
msgid ""
"%s has only %s unallocated. Metadata cannot grow and writes will stall. Open "
"the Btrfs Guard menu to reclaim space."
msgstr ""
"%s hat nur noch %s nicht zugewiesen. Metadaten können nicht mehr wachsen, und "
"Schreibvorgänge werden blockiert. Öffnen Sie das Btrfs-Guard-Menü, um "
"Speicher freizugeben."

#: extension.js:193
#, javascript-format
msgid "balancing -dusage=%d…"
msgstr "Balancierung -dusage=%d…"

#: extension.js:194
#, javascript-format
msgid "Btrfs balance -dusage=%d"
msgstr "Btrfs-Balance -dusage=%d"

#: extension.js:200
#, javascript-format
msgid "%s finished"
msgstr "%s abgeschlossen"

#: extension.js:201
#, javascript-format
msgid "Unallocated now: %s"
msgstr "Jetzt nicht zugewiesen: %s"

#: extension.js:203
#, javascript-format
msgid "%s cancelled"
msgstr "%s abgebrochen"

#: extension.js:203
msgid "Authentication was dismissed or denied."
msgstr "Die Authentifizierung wurde abgebrochen oder verweigert."

#: extension.js:205 extension.js:208
#, javascript-format
msgid "%s failed"
msgstr "%s fehlgeschlagen"

#: extension.js:235
#, javascript-format
msgid "btrfs filesystem usage %s"
msgstr "btrfs filesystem usage %s"

#: extension.js:241
msgid "Close"
msgstr "Schließen"

#: prefs.js:12
msgid "Btrfs Guard"
msgstr "Btrfs Guard"

#: prefs.js:20
msgid "Watched partitions"
msgstr "Überwachte Partitionen"

#: prefs.js:21
msgid ""
"Btrfs mount points monitored in the panel. One indicator is shown per mount "
"point."
msgstr ""
"Im Panel überwachte Btrfs-Einhängepunkte. Pro Einhängepunkt wird ein "
"Indikator angezeigt."

#: prefs.js:57
msgid "Remove this mount point"
msgstr "Diesen Einhängepunkt entfernen"

#: prefs.js:101
msgid "Add"
msgstr "Hinzufügen"

#: prefs.js:115
msgid "Detect btrfs mounts"
msgstr "Btrfs-Einhängungen erkennen"

#: prefs.js:127
msgid "Space reclaim"
msgstr "Speicherfreigabe"

#: prefs.js:128
msgid ""
"Chunks that are less full than this percentage are compacted by the "
"\"balance -dusage=N\" menu action."
msgstr ""
"Chunks, die weniger als diesen Prozentsatz gefüllt sind, werden durch die "
"Menüaktion \"balance -dusage=N\" verdichtet."

#: prefs.js:133
msgid "Chunk usage threshold"
msgstr "Schwellenwert für Chunk-Auslastung"

#: prefs.js:134
msgid "Used by balance -dusage=N (0–100%)"
msgstr "Wird von balance -dusage=N verwendet (0–100 %)"

msgid "Balance completed"
msgstr "Balancierung abgeschlossen"

msgid "No partitions configured — the panel indicator is disabled."
msgstr "Keine Partitionen konfiguriert — der Panel-Indikator ist deaktiviert."
