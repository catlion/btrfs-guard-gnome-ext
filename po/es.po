#: extension.js:85
msgid "Reclaim empty chunks  (balance -dusage=0)"
msgstr "Recuperar fragmentos vacíos  (balance -dusage=0)"

#: extension.js:94
msgid "Show filesystem usage…"
msgstr "Mostrar uso del sistema de archivos…"

#: extension.js:101
#, javascript-format
msgid "Compact chunks <%d%% full  (balance -dusage=%d)"
msgstr "Compactar fragmentos con menos de %d%% de uso  (balance -dusage=%d)"

#: extension.js:148
#, javascript-format
msgid "%s unallocated: %s of %s"
msgstr "%s sin asignar: %s de %s"

#: extension.js:149
#, javascript-format
msgid "Data: %s used of %s"
msgstr "Datos: %s usados de %s"

#: extension.js:150
#, javascript-format
msgid "Metadata: %s used of %s"
msgstr "Metadatos: %s usados de %s"

#: extension.js:156
msgid "Btrfs: low unallocated space"
msgstr "Btrfs: poco espacio sin asignar"

#: extension.js:157
#, javascript-format
msgid ""
"%s has only %s unallocated. Metadata cannot grow and writes will stall. Open "
"the Btrfs Guard menu to reclaim space."
msgstr ""
"%s solo tiene %s sin asignar. Los metadatos no pueden crecer y las escrituras "
"se bloquearán. Abra el menú de Btrfs Guard para recuperar espacio."

#: extension.js:193
#, javascript-format
msgid "balancing -dusage=%d…"
msgstr "equilibrando -dusage=%d…"

#: extension.js:194
#, javascript-format
msgid "Btrfs balance -dusage=%d"
msgstr "Equilibrio de Btrfs -dusage=%d"

#: extension.js:200
#, javascript-format
msgid "%s finished"
msgstr "%s finalizado"

#: extension.js:201
#, javascript-format
msgid "Unallocated now: %s"
msgstr "Sin asignar ahora: %s"

#: extension.js:203
#, javascript-format
msgid "%s cancelled"
msgstr "%s cancelado"

#: extension.js:203
msgid "Authentication was dismissed or denied."
msgstr "Se canceló o se denegó la autenticación."

#: extension.js:205 extension.js:208
#, javascript-format
msgid "%s failed"
msgstr "%s falló"

#: extension.js:235
#, javascript-format
msgid "btrfs filesystem usage %s"
msgstr "btrfs filesystem usage %s"

#: extension.js:241
msgid "Close"
msgstr "Cerrar"

#: prefs.js:12
msgid "Btrfs Guard"
msgstr "Btrfs Guard"

#: prefs.js:20
msgid "Watched partitions"
msgstr "Particiones vigiladas"

#: prefs.js:21
msgid ""
"Btrfs mount points monitored in the panel. One indicator is shown per mount "
"point."
msgstr ""
"Puntos de montaje de Btrfs supervisados en el panel. Se muestra un indicador "
"por cada punto de montaje."

#: prefs.js:57
msgid "Remove this mount point"
msgstr "Quitar este punto de montaje"

#: prefs.js:101
msgid "Add"
msgstr "Añadir"

#: prefs.js:115
msgid "Detect btrfs mounts"
msgstr "Detectar montajes de btrfs"

#: prefs.js:127
msgid "Space reclaim"
msgstr "Recuperación de espacio"

#: prefs.js:128
msgid ""
"Chunks that are less full than this percentage are compacted by the "
"\"balance -dusage=N\" menu action."
msgstr ""
"Los fragmentos con menos uso que este porcentaje se compactan mediante la "
"acción de menú \"balance -dusage=N\"."

#: prefs.js:133
msgid "Chunk usage threshold"
msgstr "Umbral de uso de fragmentos"

#: prefs.js:134
msgid "Used by balance -dusage=N (0–100%)"
msgstr "Usado por balance -dusage=N (0–100 %)"
