#: extension.js:85
msgid "Reclaim empty chunks  (balance -dusage=0)"
msgstr "Récupérer les chunks vides  (balance -dusage=0)"

#: extension.js:94
msgid "Show filesystem usage…"
msgstr "Afficher l’utilisation du système de fichiers…"

#: extension.js:101
#, javascript-format
msgid "Compact chunks <%d%% full  (balance -dusage=%d)"
msgstr "Compacter les chunks remplis à moins de <%d%%  (balance -dusage=%d)"

#: extension.js:148
#, javascript-format
msgid "%s unallocated: %s of %s"
msgstr "%s non alloué : %s sur %s"

#: extension.js:149
#, javascript-format
msgid "Data: %s used of %s"
msgstr "Données : %s utilisées sur %s"

#: extension.js:150
#, javascript-format
msgid "Metadata: %s used of %s"
msgstr "Métadonnées : %s utilisées sur %s"

#: extension.js:156
msgid "Btrfs: low unallocated space"
msgstr "Btrfs : espace non alloué faible"

#: extension.js:157
#, javascript-format
msgid ""
"%s has only %s unallocated. Metadata cannot grow and writes will stall. Open "
"the Btrfs Guard menu to reclaim space."
msgstr ""
"%s ne dispose que de %s non alloué. Les métadonnées ne peuvent plus croître "
"et les écritures vont se bloquer. Ouvrez le menu Btrfs Guard pour récupérer "
"de l’espace."

#: extension.js:193
#, javascript-format
msgid "balancing -dusage=%d…"
msgstr "équilibrage -dusage=%d…"

#: extension.js:194
#, javascript-format
msgid "Btrfs balance -dusage=%d"
msgstr "Équilibrage Btrfs -dusage=%d"

#: extension.js:200
#, javascript-format
msgid "%s finished"
msgstr "%s terminé"

#: extension.js:201
#, javascript-format
msgid "Unallocated now: %s"
msgstr "Non alloué désormais : %s"

#: extension.js:203
#, javascript-format
msgid "%s cancelled"
msgstr "%s annulé"

#: extension.js:203
msgid "Authentication was dismissed or denied."
msgstr "L’authentification a été annulée ou refusée."

#: extension.js:205 extension.js:208
#, javascript-format
msgid "%s failed"
msgstr "Échec de %s"

#: extension.js:235
#, javascript-format
msgid "btrfs filesystem usage %s"
msgstr "btrfs filesystem usage %s"

#: extension.js:241
msgid "Close"
msgstr "Fermer"

#: prefs.js:12
msgid "Btrfs Guard"
msgstr "Btrfs Guard"

#: prefs.js:20
msgid "Watched partitions"
msgstr "Partitions surveillées"

#: prefs.js:21
msgid ""
"Btrfs mount points monitored in the panel. One indicator is shown per mount "
"point."
msgstr ""
"Points de montage Btrfs surveillés dans le panneau. Un indicateur est "
"affiché par point de montage."

#: prefs.js:57
msgid "Remove this mount point"
msgstr "Retirer ce point de montage"

#: prefs.js:101
msgid "Add"
msgstr "Ajouter"

#: prefs.js:115
msgid "Detect btrfs mounts"
msgstr "Détecter les montages btrfs"

#: prefs.js:127
msgid "Space reclaim"
msgstr "Récupération d’espace"

#: prefs.js:128
msgid ""
"Chunks that are less full than this percentage are compacted by the "
"\"balance -dusage=N\" menu action."
msgstr ""
"Les chunks remplis à moins de ce pourcentage sont compactés par l’action de "
"menu \"balance -dusage=N\"."

#: prefs.js:133
msgid "Chunk usage threshold"
msgstr "Seuil d’utilisation des chunks"

#: prefs.js:134
msgid "Used by balance -dusage=N (0–100%)"
msgstr "Utilisé par balance -dusage=N (0–100 %)"

msgid "Balance completed"
msgstr "Équilibrage terminé"

msgid "No partitions configured — the panel indicator is disabled."
msgstr "Aucune partition configurée — l'indicateur du panneau est désactivé."

