#: extension.js:85
msgid "Reclaim empty chunks  (balance -dusage=0)"
msgstr "Освободить пустые блоки  (balance -dusage=0)"

#: extension.js:94
msgid "Show filesystem usage…"
msgstr "Показать использование файловой системы…"

#: extension.js:101
#, javascript-format
msgid "Compact chunks <%d%% full  (balance -dusage=%d)"
msgstr "Уплотнить блоки, заполненные меньше чем на %d%%  (balance -dusage=%d)"

#: extension.js:148
#, javascript-format
msgid "%s unallocated: %s of %s"
msgstr "%s не выделено: %s из %s"

#: extension.js:149
#, javascript-format
msgid "Data: %s used of %s"
msgstr "Данные: использовано %s из %s"

#: extension.js:150
#, javascript-format
msgid "Metadata: %s used of %s"
msgstr "Метаданные: использовано %s из %s"

#: extension.js:156
msgid "Btrfs: low unallocated space"
msgstr "Btrfs: мало нераспределённого места"

#: extension.js:157
#, javascript-format
msgid ""
"%s has only %s unallocated. Metadata cannot grow and writes will stall. Open "
"the Btrfs Guard menu to reclaim space."
msgstr ""
"На %s осталось всего %s нераспределённого места. Метаданные не могут расти, "
"запись будет приостановлена. Откройте меню Btrfs Guard, чтобы освободить "
"место."

#: extension.js:193
#, javascript-format
msgid "balancing -dusage=%d…"
msgstr "балансировка -dusage=%d…"

#: extension.js:194
#, javascript-format
msgid "Btrfs balance -dusage=%d"
msgstr "Btrfs balance -dusage=%d"

#: extension.js:200
#, javascript-format
msgid "%s finished"
msgstr "%s завершено"

#: extension.js:201
#, javascript-format
msgid "Unallocated now: %s"
msgstr "Теперь нераспределено: %s"

#: extension.js:203
#, javascript-format
msgid "%s cancelled"
msgstr "%s отменено"

#: extension.js:203
msgid "Authentication was dismissed or denied."
msgstr "Аутентификация отклонена или не подтверждена."

#: extension.js:205 extension.js:208
#, javascript-format
msgid "%s failed"
msgstr "%s завершилось с ошибкой"

#: extension.js:235
#, javascript-format
msgid "btrfs filesystem usage %s"
msgstr "btrfs filesystem usage %s"

#: extension.js:241
msgid "Close"
msgstr "Закрыть"

#: prefs.js:12
msgid "Btrfs Guard"
msgstr "Btrfs Guard"

#: prefs.js:20
msgid "Watched partitions"
msgstr "Отслеживаемые разделы"

#: prefs.js:21
msgid ""
"Btrfs mount points monitored in the panel. One indicator is shown per mount "
"point."
msgstr ""
"Точки монтирования Btrfs, которые отслеживаются на панели. Для каждой точки "
"монтирования отображается один индикатор."

#: prefs.js:57
msgid "Remove this mount point"
msgstr "Удалить эту точку монтирования"

#: prefs.js:101
msgid "Add"
msgstr "Добавить"

#: prefs.js:115
msgid "Detect btrfs mounts"
msgstr "Найти точки монтирования btrfs"

#: prefs.js:127
msgid "Space reclaim"
msgstr "Освобождение места"

#: prefs.js:128
msgid ""
"Chunks that are less full than this percentage are compacted by the "
"\"balance -dusage=N\" menu action."
msgstr ""
"Блоки, заполненные меньше этого процента, уплотняются действием меню "
"«balance -dusage=N»."

#: prefs.js:133
msgid "Chunk usage threshold"
msgstr "Порог заполнения блоков"

#: prefs.js:134
msgid "Used by balance -dusage=N (0–100%)"
msgstr "Используется в balance -dusage=N (0–100%)"

msgid "Balance completed"
msgstr "Балансировка завершена"

msgid "No partitions configured — the panel indicator is disabled."
msgstr "Разделы не настроены — индикатор на панели отключён."

