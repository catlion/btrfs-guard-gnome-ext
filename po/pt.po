#: extension.js:85
msgid "Reclaim empty chunks  (balance -dusage=0)"
msgstr "Recuperar chunks vazios  (balance -dusage=0)"

#: extension.js:94
msgid "Show filesystem usage…"
msgstr "Mostrar utilização do sistema de ficheiros…"

#: extension.js:101
#, javascript-format
msgid "Compact chunks <%d%% full  (balance -dusage=%d)"
msgstr "Compactar chunks com menos de <%d%% cheios  (balance -dusage=%d)"

#: extension.js:148
#, javascript-format
msgid "%s unallocated: %s of %s"
msgstr "%s não alocado: %s de %s"

#: extension.js:149
#, javascript-format
msgid "Data: %s used of %s"
msgstr "Dados: %s usados de %s"

#: extension.js:150
#, javascript-format
msgid "Metadata: %s used of %s"
msgstr "Metadados: %s usados de %s"

#: extension.js:156
msgid "Btrfs: low unallocated space"
msgstr "Btrfs: pouco espaço não alocado"

#: extension.js:157
#, javascript-format
msgid ""
"%s has only %s unallocated. Metadata cannot grow and writes will stall. Open "
"the Btrfs Guard menu to reclaim space."
msgstr ""
"%s tem apenas %s não alocado. Os metadados não podem crescer e as escritas "
"vão bloquear. Abra o menu do Btrfs Guard para recuperar espaço."

#: extension.js:193
#, javascript-format
msgid "balancing -dusage=%d…"
msgstr "a equilibrar -dusage=%d…"

#: extension.js:194
#, javascript-format
msgid "Btrfs balance -dusage=%d"
msgstr "Equilíbrio Btrfs -dusage=%d"

#: extension.js:200
#, javascript-format
msgid "%s finished"
msgstr "%s concluído"

#: extension.js:201
#, javascript-format
msgid "Unallocated now: %s"
msgstr "Não alocado agora: %s"

#: extension.js:203
#, javascript-format
msgid "%s cancelled"
msgstr "%s cancelado"

#: extension.js:203
msgid "Authentication was dismissed or denied."
msgstr "A autenticação foi cancelada ou negada."

#: extension.js:205 extension.js:208
#, javascript-format
msgid "%s failed"
msgstr "%s falhou"

#: extension.js:235
#, javascript-format
msgid "btrfs filesystem usage %s"
msgstr "utilização do sistema de ficheiros btrfs %s"

#: extension.js:241
msgid "Close"
msgstr "Fechar"

#: prefs.js:12
msgid "Btrfs Guard"
msgstr "Btrfs Guard"

#: prefs.js:20
msgid "Watched partitions"
msgstr "Partições monitorizadas"

#: prefs.js:21
msgid ""
"Btrfs mount points monitored in the panel. One indicator is shown per mount "
"point."
msgstr ""
"Pontos de montagem Btrfs monitorizados no painel. É apresentado um indicador "
"por ponto de montagem."

#: prefs.js:57
msgid "Remove this mount point"
msgstr "Remover este ponto de montagem"

#: prefs.js:101
msgid "Add"
msgstr "Adicionar"

#: prefs.js:115
msgid "Detect btrfs mounts"
msgstr "Detetar montagens btrfs"

#: prefs.js:127
msgid "Space reclaim"
msgstr "Recuperação de espaço"

#: prefs.js:128
msgid ""
"Chunks that are less full than this percentage are compacted by the "
"\"balance -dusage=N\" menu action."
msgstr ""
"Os chunks com menos ocupação do que esta percentagem são compactados pela "
"ação de menu \"balance -dusage=N\"."

#: prefs.js:133
msgid "Chunk usage threshold"
msgstr "Limite de utilização do chunk"

#: prefs.js:134
msgid "Used by balance -dusage=N (0–100%)"
msgstr "Usado por balance -dusage=N (0–100%)"
