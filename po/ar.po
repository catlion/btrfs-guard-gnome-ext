#: extension.js:85
msgid "Reclaim empty chunks  (balance -dusage=0)"
msgstr "استعادة Chunks الفارغة  (balance -dusage=0)"

#: extension.js:94
msgid "Show filesystem usage…"
msgstr "عرض استخدام نظام الملفات…"

#: extension.js:101
#, javascript-format
msgid "Compact chunks <%d%% full  (balance -dusage=%d)"
msgstr "ضغط Chunks التي تقل نسبة امتلائها عن <%d%%  (balance -dusage=%d)"

#: extension.js:148
#, javascript-format
msgid "%s unallocated: %s of %s"
msgstr "%s غير مخصص: %s من %s"

#: extension.js:149
#, javascript-format
msgid "Data: %s used of %s"
msgstr "البيانات: %s مستخدمة من %s"

#: extension.js:150
#, javascript-format
msgid "Metadata: %s used of %s"
msgstr "البيانات الوصفية: %s مستخدمة من %s"

#: extension.js:156
msgid "Btrfs: low unallocated space"
msgstr "Btrfs: مساحة غير مخصصة منخفضة"

#: extension.js:157
#, javascript-format
msgid ""
"%s has only %s unallocated. Metadata cannot grow and writes will stall. Open "
"the Btrfs Guard menu to reclaim space."
msgstr ""
"لم يبقَ من %s سوى %s غير مخصص. لا يمكن للبيانات الوصفية أن تنمو، وستتوقف "
"عمليات الكتابة. افتح قائمة Btrfs Guard لاستعادة المساحة."

#: extension.js:193
#, javascript-format
msgid "balancing -dusage=%d…"
msgstr "جارٍ الموازنة -dusage=%d…"

#: extension.js:194
#, javascript-format
msgid "Btrfs balance -dusage=%d"
msgstr "موازنة Btrfs -dusage=%d"

#: extension.js:200
#, javascript-format
msgid "%s finished"
msgstr "اكتمل %s"

#: extension.js:201
#, javascript-format
msgid "Unallocated now: %s"
msgstr "غير المخصص الآن: %s"

#: extension.js:203
#, javascript-format
msgid "%s cancelled"
msgstr "أُلغي %s"

#: extension.js:203
msgid "Authentication was dismissed or denied."
msgstr "أُلغيت المصادقة أو رُفضت."

#: extension.js:205 extension.js:208
#, javascript-format
msgid "%s failed"
msgstr "فشل %s"

#: extension.js:235
#, javascript-format
msgid "btrfs filesystem usage %s"
msgstr "btrfs filesystem usage %s"

#: extension.js:241
msgid "Close"
msgstr "إغلاق"

#: prefs.js:12
msgid "Btrfs Guard"
msgstr "Btrfs Guard"

#: prefs.js:20
msgid "Watched partitions"
msgstr "الأقسام المراقبة"

#: prefs.js:21
msgid ""
"Btrfs mount points monitored in the panel. One indicator is shown per mount "
"point."
msgstr ""
"نقاط تركيب Btrfs المراقبة في اللوحة. يُعرض مؤشر واحد لكل نقطة تركيب."

#: prefs.js:57
msgid "Remove this mount point"
msgstr "إزالة نقطة التركيب هذه"

#: prefs.js:101
msgid "Add"
msgstr "إضافة"

#: prefs.js:115
msgid "Detect btrfs mounts"
msgstr "اكتشاف عمليات تركيب btrfs"

#: prefs.js:127
msgid "Space reclaim"
msgstr "استعادة المساحة"

#: prefs.js:128
msgid ""
"Chunks that are less full than this percentage are compacted by the "
"\"balance -dusage=N\" menu action."
msgstr ""
"تُضغط Chunks التي تقل نسبة امتلائها عن هذه النسبة المئوية عبر إجراء القائمة "
"\"balance -dusage=N\"."

#: prefs.js:133
msgid "Chunk usage threshold"
msgstr "حد استخدام Chunk"

#: prefs.js:134
msgid "Used by balance -dusage=N (0–100%)"
msgstr "يستخدمه balance -dusage=N (0–100%)"

msgid "Balance completed"
msgstr "اكتملت الموازنة"

msgid "No partitions configured — the panel indicator is disabled."
msgstr "لم تُهيأ أي أقسام — مؤشر اللوحة معطّل."
